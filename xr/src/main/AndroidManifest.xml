<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">
    <!-- OpenGL ES -->
    <uses-feature 
          android:glEsVersion="0x00030002"
          android:required="false" />
    <!-- OpenGL ES 硬件功能 -->
    <uses-feature 
          android:name="android.hardware.opengles.aep"
          android:required="false" />
    <!-- 传感器 -->
    <uses-feature 
          android:name="android.hardware.sensor"
          android:required="false" />
    <!-- Mega-Feature -->
    <uses-feature 
          android:name="android.hardware.sensor.hifi_sensors"
          android:required="false" />
    <!-- 加速度传感器 -->
    <uses-feature 
          android:name="android.hardware.sensor.accelerometer"
          android:required="false" />
    <!-- 环境温度计 -->
    <uses-feature 
          android:name="android.hardware.sensor.ambient_temperature"
          android:required="false" />
    <!-- 地磁传感器 -->
    <uses-feature 
          android:name="android.hardware.sensor.compass"
          android:required="false" />
    <!-- 角速度传感器 -->
    <uses-feature 
          android:name="android.hardware.sensor.gyroscope"
          android:required="false" />
    <!-- 环境光传感器 -->
    <uses-feature 
          android:name="android.hardware.sensor.light"
          android:required="false" />
    <!-- 距离传感器 -->
    <uses-feature 
          android:name="android.hardware.sensor.proximity"
          android:required="false" />
    <!-- 相对湿度计 -->
    <uses-feature 
          android:name="android.hardware.sensor.relative_humidity"
          android:required="false" />
    <!-- 配套设备 -->
    <uses-feature 
          android:name="android.software.companion_device_setup"
          android:required="false" />
    
    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 允许应用阻止非系统覆盖窗口绘制在其上方 -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- 防止手机休眠 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 以高采样率访问传感器数据 -->
    <uses-permission 
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />
    <!-- 开机启动 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 强制更新所有权 -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <!-- 在后台运行 -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <!-- 在后台使用数据 -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND" />
    <!-- 发送持久广播 -->
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />
    <!-- 显示通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 运行前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 运行「dataSync」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 运行「specialUse」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 运行「systemExempted」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- 运行「camera」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- 运行「connectedDevice」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 运行「fileManagement」类型的前台服务 -->
    <uses-permission 
        android:name="android.permission.FOREGROUND_SERVICE_FILE_MANAGEMENT"
        tools:ignore="SystemPermissionTypo" />
    <!-- 运行「health」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- 运行「location」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 运行「mediaPlayback」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 运行「mediaProjection」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 运行「microphone」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 运行「phoneCall」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- 运行「remoteMessaging」类型的前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- 禁用键盘锁 -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <application
        android:process=":xr"
        android:directBootAware="true"
        android:usesNonSdkApi="true"
        android:resizeableActivity="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="37">
        <activity-alias
             android:name="aliasActivity"
             android:exported="true"
             android:targetActivity="SpatialStorageActivity">
            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />
                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity 
            android:name="SpatialStorageActivity"
            android:process=":xr"
            android:directBootAware="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleInstancePerTask"
            android:persistableMode="persistNever"
            android:exported="true" >
            <property 
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE" 
                android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_MANAGED" />
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:process=":xr"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/uncompressed_dex_opt_out" />
        </provider>
    </application>
</manifest>