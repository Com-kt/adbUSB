<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Ignore trust manager warnings originating from the Gradle cache folder -->
    <issue id="TrustAllX509TrustManager">
        <ignore path="**/caches/**" />
        <ignore path="**/transformed/**" />
    </issue>
    
    <!-- Ignore discouraged private API reflections inside your P2P Service file -->
    <issue id="DiscouragedPrivateApi">
        <ignore path="**/AdbSessionService.kt" />
    </issue>

    <!-- Optional: If you use regular Java reflection elsewhere with HiddenApiBypass -->
    <issue id="SoonBlockedPrivateApi">
        <ignore path="**/AdbSessionService.kt" />
    </issue>
</lint>