<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">
    
    <!-- 要求 Android 系统必须支持USB主机模式，后续无线调试实现完成以后，USB主机模式也可能会沦为次要的，因为无线调试它只需要 WLAN 相关功能，所以暂时设置为 true -->
    <uses-feature 
          android:name="android.hardware.usb.host"
          android:required="true" />
    <!-- 不一定要 Android 系统支持USB配件模式，因为USB主机模式才是主要的，USB配件模式是次要的，因此设置 android:required 为 false -->
    <uses-feature 
          android:name="android.hardware.usb.accessory"
          android:required="false" />
            
    <!-- USB 权限，哈哈哈，其实也不需要声明这个权限，因为 USB 基本上都是通过系统广播来授权，删掉也无妨，声明只是为了让程序显得更规范 -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <!-- 防止手机休眠 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 以高采样率访问传感器数据 -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- 开机启动 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 强制更新所有权 -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <!-- 在后台运行 -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <!-- 在后台使用数据 -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND" />
    
    <application 
        android:allowBackup="true" 
        android:directBootAware="true"
        android:usesNonSdkApi="true"
        android:resizeableActivity="true"
        android:appCategory="productivity"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher" 
        android:roundIcon="@mipmap/ic_launcher" 
        android:label="@string/app_name" 
        android:supportsRtl="true" 
        android:theme="@style/AppTheme"
        tools:targetApi="37">
        <!-- 这个库必须添加，但不强制要求安装的系统上一定要有这个库，因为USB主机模式才是主要的，USB配件模式是次要的，因此设置 android:required 为 false -->
        <uses-library 
            android:name="com.android.future.usb.accessory"
            android:required="false" />
        <activity 
            android:name="MainActivity"
            android:directBootAware="true"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action 
                    android:name="android.intent.action.MAIN" />
                <category 
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- USB主机模式 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <!-- USB配件模式 -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <!-- USB主机模式配置 -->
            <meta-data 
                 android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                 android:resource="@xml/usb_device_filter" />
            <!-- USB配件模式配置 -->
            <meta-data
                 android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                 android:resource="@xml/accessory_filter" />
        </activity>
    </application>
</manifest>