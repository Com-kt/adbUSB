<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://android.com"
    android:shape="rectangle">
    
    <solid android:color="?attr/colorSurfaceContainerHighest" /> 
    
    <!-- 💡 控制弧度：原生的胶囊通常是 24dp 以上，这里改成 8dp 的精致微圆角 -->
    <corners android:radius="8dp" />
    
    <!-- 可选：如果你觉得纯色没有立体感，可以加一个极细的 M3 动态边框线 -->
    <stroke 
        android:width="1dp" 
        android:color="?attr/colorOutlineVariant" />
</shape>
