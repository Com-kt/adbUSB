<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_main_activity_xml_btnConnect"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="@dimen/activity_xml_layout_marginEnd"
        android:layout_marginStart="@dimen/activity_xml_layout_marginStart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etCommand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/app_main_activity_xml_etCommand"
        android:layout_marginEnd="@dimen/activity_xml_layout_marginEnd"
        android:layout_marginStart="@dimen/activity_xml_layout_marginStart"
        app:layout_constraintTop_toBottomOf="@+id/btnConnect"
        app:layout_constraintBottom_toTopOf="@+id/btnSend"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_main_activity_xml_btnSend"
        android:layout_marginEnd="@dimen/activity_xml_layout_marginEnd"
        android:layout_marginStart="@dimen/activity_xml_layout_marginStart"
        app:layout_constraintTop_toBottomOf="@+id/etCommand"
        app:layout_constraintBottom_toTopOf="@+id/fbSelinux"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
        
    <Button
        android:id="@+id/fbSelinux"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_main_activity_xml_fbSelinux"
        android:layout_marginEnd="@dimen/activity_xml_layout_marginEnd"
        android:layout_marginStart="@dimen/activity_xml_layout_marginStart"
        app:layout_constraintTop_toBottomOf="@+id/btnSend"
        app:layout_constraintBottom_toTopOf="@+id/scrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="700dp"
        android:layout_margin="8dp"
        android:layout_marginEnd="@dimen/activity_xml_layout_marginEnd"
        android:layout_marginStart="@dimen/activity_xml_layout_marginStart"
        android:background="#F0F0F0"
        android:padding="8dp"
        android:id="@+id/scrollView"
        app:layout_constraintTop_toBottomOf="@+id/fbSelinux"
        app:layout_constraintBottom_toTopOf="@+id/bakck"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" >

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="@string/app_main_activity_xml_tvLog" />
    </androidx.core.widget.NestedScrollView>
    
    <TextView
        android:id="@+id/bakck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_main_activity_xml_bakck"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>