<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="扫描并申请权限"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="13dp"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etCommand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="输入 adb 命令 / fastboot 命令"
        android:layout_marginEnd="13dp"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toBottomOf="@+id/btnConnect"
        app:layout_constraintBottom_toTopOf="@+id/btnSend"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="发送命令"
        android:layout_marginEnd="13dp"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toBottomOf="@+id/etCommand"
        app:layout_constraintBottom_toTopOf="@+id/fbSelinux"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
        
    <Button
        android:id="@+id/fbSelinux"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="一键设置 Selinux 宽容模式"
        android:layout_marginEnd="13dp"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toBottomOf="@+id/btnSend"
        app:layout_constraintBottom_toTopOf="@+id/scrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="700dp"
        android:layout_margin="8dp"
        android:layout_marginEnd="13dp"
        android:layout_marginStart="13dp"
        android:background="#F0F0F0"
        android:padding="8dp"
        android:id="@+id/scrollView"
        app:layout_constraintTop_toBottomOf="@+id/fbSelinux"
        app:layout_constraintBottom_toTopOf="@+id/bakck"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" >

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="日志输出... \n" />
    </androidx.core.widget.NestedScrollView>
    
    <TextView
        android:id="@+id/bakck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="USB线刷工具-小米版本"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>