<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dialog_simple_xml_layout_margin"
    android:layout_marginBottom="@dimen/dialog_simple_xml_layout_margin"
    android:layout_marginEnd="@dimen/dialog_simple_xml_layout_margin"
    android:layout_marginStart="@dimen/dialog_simple_xml_layout_margin"
    android:padding="@dimen/dialog_simple_xml_layout_margin" >
    <TextView
        android:id="@+id/dialogText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp" />
</LinearLayout>
