#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

layout(std430, binding = 0) readonly buffer InputBuffer {
    uint pixels[];
} inputData;

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    uint pixels[];
} outputData;

vec3 getPixelColor(uint x, uint y) {
    uint clampedX = clamp(x, 0, pc.width - 1);
    uint clampedY = clamp(y, 0, pc.height - 1);
    uint idx = clampedY * pc.width + clampedX;
    uint p = inputData.pixels[idx];
    
    return vec3(float(p & 0xFFu), float((p >> 8) & 0xFFu), float((p >> 16) & 0xFFu)) / 255.0;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
    if (x >= pc.width || y >= pc.height) return;

    vec3 center = getPixelColor(x, y);
    vec3 top    = getPixelColor(x, y - 1);
    vec3 bottom = getPixelColor(x, y + 1);
    vec3 left   = getPixelColor(x - 1, y);
    vec3 right  = getPixelColor(x + 1, y);

    vec3 sharpColor = center * 5.0 - (top + bottom + left + right);
    sharpColor = clamp(sharpColor, 0.0, 1.0);

    uint idx = y * pc.width + x;
    uint originalAlpha = (inputData.pixels[idx] >> 24) & 0xFFu;

    uint r = uint(sharpColor.r * 255.0);
    uint g = uint(sharpColor.g * 255.0);
    uint b = uint(sharpColor.b * 255.0);
    
    outputData.pixels[idx] = r | (g << 8) | (b << 16) | (originalAlpha << 24);
}
